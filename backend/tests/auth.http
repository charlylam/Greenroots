  "lastName": "Test",
  "firstName": "Register",
  "email": "register.test@email.fr",
  "password": "Password123!",
  "address": "1 rue test",
  "postalCode": "01000",
  "city": "Bourg-en-Bresse",
  "type": "particulier"
}

